# pacs-agent/.env.example
#
# Copier ce fichier en "pacs-agent/.env" sur CHAQUE machine de site, et
# remplir les valeurs reelles. ".env" est dans .gitignore (*.env) : ne
# jamais le commiter, il contient un secret.
#
# Voir docs/pacs-agent-deploiement-site.md pour la procedure complete.

# _id de l etablissement dans Totalis (visible dans l URL de sa fiche)
SITE_COMPANY_ID=

# Jeton d agent — genere depuis l onglet PACS de "Gerer le centre"
# (POST /company/:companyId/pacs-agent/token). Montre UNE SEULE FOIS a la
# generation : le copier immediatement ici.
SITE_TOKEN=

# Adresse PUBLIQUE du site (celle que les utilisateurs tapent dans leur
# navigateur), pas une adresse interne au VPC/reseau Docker — voir
# docs/pacs-agent-deploiement-site.md section 4.
TOTALIS_URL=https://hgp.totalis.clinic/api

# A ne redefinir que si Orthanc ne tourne pas avec sa config par defaut sur
# cette machine (API REST, PAS le port DICOM 4242).
# ORTHANC_URL=http://localhost:8042

# Doit correspondre exactement a "Database" dans la Configuration Orthanc
# (worklists.json) sur CETTE machine.
# WORKLIST_DIR=C:/Orthanc/worklists

# Cadences par defaut (15s / 60s) — a ajuster seulement si besoin.
# POLL_INTERVAL_MS=15000
# HEARTBEAT_INTERVAL_MS=60000
